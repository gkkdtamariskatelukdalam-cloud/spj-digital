// Prisma schema for SPJ (Surat Pertanggungjawaban) Application
// Sistem Pertanggungjawaban Pengadaan ATK - SMA Negeri 1 Telukdalam

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ MASTER DATA ============

model School {
  id        String  @id @default(cuid())
  name      String
  npsn      String?
  address   String?
  // Officials
  principalName      String?
  principalNip        String?
  principalRank       String?
  treasurerName      String?
  treasurerNip       String?
  treasurerRank      String?
  goodsManagerName   String?
  goodsManagerNip    String?
  goodsManagerRank   String?
  receiverName       String?
  receiverPhone      String?
  year               Int     @default(2025)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  owner     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  spec      String?
  unit      String?
  price     Float    @default(0)
  category  String   @default("ATK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bpu {
  id        String   @id @default(cuid())
  code      String   @unique
  noPesan   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ TRANSACTIONS ============

model Transaction {
  id            String    @id @default(cuid())
  noUrut        Int?
  tglPesan      String?   // dd/mm/yyyy or ISO
  noPesan       String?
  tglBast       String?
  noBast        String?
  tglBayar      String?
  noBku         String?
  bpuCode       String?
  uraian        String
  namaBarang    String?
  volume        Float     @default(0)
  satuan        String?
  tarifHarga    Float     @default(0)
  jumlah        Float     @default(0)
  realisasi     Float     @default(0)
  bulan         Int?      // 1-12
  tahun         Int       @default(2025)
  masukBku      String?
  status        String    @default("lunas") // lunas, pending, draft
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  documents     Document[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([bulan])
  @@index([tahun])
  @@index([vendorId])
  @@index([noBku])
}

// ============ DOCUMENTS (SPJ supporting docs) ============

model Document {
  id            String   @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  type          String   // PESAN, BANDING, RENCANA, SHP, BAT, SPJ
  docNumber     String?
  docDate       String?
  amount        Float?
  filePath      String?
  status        String   @default("generated") // generated, printed, verified
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([transactionId])
  @@index([type])
}

// ============ LETTERHEAD (KOP SURAT) SETTINGS ============

model LetterheadSettings {
  id              String   @id @default(cuid())
  
  // Logo settings
  logoPath        String?  // relative path to uploaded logo, e.g. /uploads/logo.png
  logoWidth       Int      @default(110)  // logo width in px
  logoHeight      Int      @default(110)   // logo height in px (auto if 0)
  logoOffsetX     Int      @default(0)     // horizontal shift: negative=left, positive=right
  logoOffsetY     Int      @default(0)     // vertical shift: negative=up, positive=down
  
  // Font settings
  fontFamily      String   @default("Arial")
  lineSpacing     Int      @default(6)     // extra spacing between lines in px
  
  // 7 text lines (KOP structure)
  line1Text       String   @default("PEMERINTAH PROVINSI SUMATERA UTARA")
  line1Bold       Boolean  @default(true)
  line1Size       Int      @default(14)
  
  line2Text       String   @default("DINAS PENDIDIKAN")
  line2Bold       Boolean  @default(true)
  line2Size       Int      @default(14)
  
  line3Text       String   @default("SMA NEGERI 1 TELUKDALAM")
  line3Bold       Boolean  @default(true)
  line3Size       Int      @default(20)
  
  line4Text       String   @default("Jl. Pendidikan No.13, Kel. Pasar Teluk Dalam, Kec. Teluk Dalam, Kab. Nias Selatan,")
  line4Bold       Boolean  @default(false)
  line4Size       Int      @default(11)
  
  line5Text       String   @default("Cabdisdik Wil XIV, Kode Pos 22865")
  line5Bold       Boolean  @default(false)
  line5Size       Int      @default(11)
  
  line6Text       String   @default("Telp/HP: 081370904506, Pos-el smansatelukdalam1987@gmail.com")
  line6Bold       Boolean  @default(false)
  line6Size       Int      @default(11)
  
  line7Text       String   @default("Laman : smansatelukdalam.sch.id")
  line7Bold       Boolean  @default(false)
  line7Size       Int      @default(11)
  
  // Bottom border line
  showBottomLine  Boolean  @default(true)
  bottomLineWidth Int      @default(2)     // border thickness in px
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

