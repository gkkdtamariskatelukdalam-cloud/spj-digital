// Prisma schema for SPJ (Surat Pertanggungjawaban) Application
// Sistem Pertanggungjawaban Pengadaan ATK - SMA Negeri 1 Telukdalam

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ MASTER DATA ============

model School {
  id        String  @id @default(cuid())
  name      String
  npsn      String?
  address   String?
  // Officials
  principalName      String?
  principalNip        String?
  principalRank       String?
  treasurerName      String?
  treasurerNip       String?
  treasurerRank      String?
  goodsManagerName   String?
  goodsManagerNip    String?
  goodsManagerRank   String?
  receiverName       String?
  receiverPhone      String?
  year               Int     @default(2025)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  owner     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  spec      String?
  unit      String?
  price     Float    @default(0)
  category  String   @default("ATK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bpu {
  id        String   @id @default(cuid())
  code      String   @unique
  noPesan   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ TRANSACTIONS ============

model Transaction {
  id            String    @id @default(cuid())
  noUrut        Int?
  
  // === Excel columns (in exact order) ===
  // Col A: No. Surat Pesan
  noPesan       String?
  // Col B: No BKU
  noBku         String?
  // Col C: Kode Program
  kodeProgram   String?
  // Col D: Kode Rekening
  kodeRekening  String?
  // Col E: Tanggal Perencanaan
  tglPerencanaan String?
  // Col F: Tanggal Pesanan
  tglPesan      String?
  // Col G: Tanggal BAST
  tglBast       String?
  noBast        String?
  // Col H: Tanggal Pemeriksaan
  tglPeriksa    String?
  // Col I: Tanggal Bayar
  tglBayar      String?
  // Col J: Uraian Kegiatan
  uraian        String
  // Col K: Nama Barang
  namaBarang    String?
  // Col L: Volume
  volume        Float     @default(0)
  // Col M: Satuan
  satuan        String?
  // Col N: Harga Satuan
  tarifHarga    Float     @default(0)
  // Col O: Jumlah
  jumlah        Float     @default(0)
  // Col P: Kategori Belanja
  kategoriBelanja String?
  // Col Q: Spesifikasi Barang
  spesifikasiBarang String?
  // Col R: Harga Toko 1
  hargaToko1    Float?
  // Col S: Harga Toko 2
  hargaToko2    Float?
  // Col T: Nama Toko 1 (stored raw text, also linked to Vendor)
  namaToko1     String?
  // Col U: Nama Toko 2
  namaToko2     String?
  // Col V: Direktur Toko 1
  direkturToko1 String?
  // Col W: Alamat Toko 1
  alamatToko1  String?
  // Col X: Alamat Toko 2
  alamatToko2  String?
  // Col Y: Uraian Kwitansi
  uraianKwitansi String?
  // Col Z: Nama Pekerjaan / Kategori
  namaPekerjaanKategori String?
  // Col AA: Satuan (second)
  satuan2      String?
  // Col AB: Harga Satuan sebelum pajak
  hargaSatuanSebelumPajak Float?
  // Col AC: Jumlah Harga Sebelum Pajak
  jumlahHargaSebelumPajak Float?
  // Col AD: Harga Total Asli
  hargaTotalAsli Float?
  // Col AE: Total Harga Sebelum DPP
  totalHargaSebelumDPP Float?
  // Col AF: Total Harga Asli
  totalHargaAsli Float?
  // Col AG: Alamat Surat Balasan Toko
  alamatSuratBalasan String?
  // Col AH: NO HP
  noHp         String?
  
  // === Computed/derived fields ===
  realisasi     Float     @default(0)
  bulan         Int?
  tahun         Int       @default(2025)
  masukBku      String?
  status        String    @default("lunas") // lunas, pending, draft
  bpuCode       String?
  vendorId      String?
  excelRowNum   Int?      // original Excel row number for dedup tracking
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  documents     Document[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([bulan])
  @@index([tahun])
  @@index([vendorId])
  @@index([noBku])
}

// ============ DOCUMENTS (SPJ supporting docs) ============

model Document {
  id            String   @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  type          String   // PESAN, BANDING, RENCANA, SHP, BAT, SPJ
  docNumber     String?
  docDate       String?
  amount        Float?
  filePath      String?
  status        String   @default("generated") // generated, printed, verified
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([transactionId])
  @@index([type])
}

// ============ PRINT STATUS (TRACKING CETAK DOKUMEN) ============

model PrintStatus {
  id            String   @id @default(cuid())
  groupKey      String   // noPesan atau noBku (identifikasi pesanan)
  docType       String   // surat-pesanan, dokumen-pembanding, dll
  printedAt     DateTime @default(now())
  printedCount  Int      @default(1)  // berapa kali dicetak
  
  @@unique([groupKey, docType])
  @@index([groupKey])
}

// ============ LETTERHEAD (KOP SURAT) SETTINGS ============

model LetterheadSettings {
  id              String   @id @default(cuid())
  
  // Logo settings
  logoPath        String?  // relative path to uploaded logo, e.g. /uploads/logo.png
  logoWidth       Int      @default(110)  // logo width in px
  logoHeight      Int      @default(110)   // logo height in px (auto if 0)
  logoOffsetX     Int      @default(0)     // horizontal shift: negative=left, positive=right
  logoOffsetY     Int      @default(0)     // vertical shift: negative=up, positive=down
  
  // Logo 2 settings (for KOP with 2 logos - left and right)
  logo2Path       String?
  logo2Width      Int      @default(110)
  logo2Height     Int      @default(110)
  logo2OffsetX    Int      @default(0)
  logo2OffsetY    Int      @default(0)
  
  // KOP mode: "single" (1 logo left) or "dual" (2 logos left+right, text centered)
  kopMode         String   @default("single")
  
  // Font settings (shared between both modes)
  fontFamily      String   @default("Arial")
  lineSpacing     Int      @default(6)     // extra spacing between lines in px
  
  // === KOP 1 LOGO lines (single mode) ===
  line1Text       String   @default("PEMERINTAH PROVINSI SUMATERA UTARA")
  line1Bold       Boolean  @default(true)
  line1Size       Int      @default(14)
  
  line2Text       String   @default("DINAS PENDIDIKAN")
  line2Bold       Boolean  @default(true)
  line2Size       Int      @default(14)
  
  line3Text       String   @default("SMA NEGERI 1 TELUKDALAM")
  line3Bold       Boolean  @default(true)
  line3Size       Int      @default(20)
  
  line4Text       String   @default("Jl. Pendidikan No.13, Kel. Pasar Teluk Dalam, Kec. Teluk Dalam, Kab. Nias Selatan,")
  line4Bold       Boolean  @default(false)
  line4Size       Int      @default(11)
  
  line5Text       String   @default("Cabdisdik Wil.XIV, Kode Pos 22865")
  line5Bold       Boolean  @default(false)
  line5Size       Int      @default(11)
  
  line6Text       String   @default("Telp/HP: 081370904506, Pos-el smansatelukdalam1987@gmail.com")
  line6Bold       Boolean  @default(false)
  line6Size       Int      @default(11)
  
  line7Text       String   @default("Laman : smansatelukdalam.sch.id")
  line7Bold       Boolean  @default(false)
  line7Size       Int      @default(11)
  
  // === KOP 2 LOGO lines (dual mode) ===
  dualLine1Text       String   @default("PEMERINTAH PROVINSI SUMATERA UTARA")
  dualLine1Bold       Boolean  @default(true)
  dualLine1Size       Int      @default(14)
  
  dualLine2Text       String   @default("DINAS PENDIDIKAN")
  dualLine2Bold       Boolean  @default(true)
  dualLine2Size       Int      @default(14)
  
  dualLine3Text       String   @default("CABDIS PENDIDIKAN WILAYAH XIV")
  dualLine3Bold       Boolean  @default(true)
  dualLine3Size       Int      @default(13)
  
  dualLine4Text       String   @default("SMA NEGERI 1 TELUKDALAM")
  dualLine4Bold       Boolean  @default(true)
  dualLine4Size       Int      @default(20)
  
  dualLine5Text       String   @default("NIS : 300010         NPSN : 10258246        Terakreditasi A           NSS: 301071701001")
  dualLine5Bold       Boolean  @default(false)
  dualLine5Size       Int      @default(11)
  
  dualLine6Text       String   @default("Jl. Pendidikan No. 13 Kelurahan Pasar Telukdalam Kecamatan Telukdalam Kabupaten Nias Selatan; Telp/HP: 081370904506; Kode Pos: 22865")
  dualLine6Bold       Boolean  @default(false)
  dualLine6Size       Int      @default(11)
  
  dualLine7Text       String   @default("Email: smansatelukdalam1987@gmail.com ; website: www.smansatelukdalam.sch.id")
  dualLine7Bold       Boolean  @default(false)
  dualLine7Size       Int      @default(11)
  
  // Bottom border line
  showBottomLine  Boolean  @default(true)
  bottomLineWidth Int      @default(2)     // border thickness in px
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

